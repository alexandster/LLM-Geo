<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="description" attr.type="string" />
  <key id="d1" for="node" attr.name="data_path" attr.type="string" />
  <key id="d0" for="node" attr.name="node_type" attr.type="string" />
  <graph edgedefault="directed">
    <node id="covid_data_url">
      <data key="d0">data</data>
      <data key="d1">https://github.com/nytimes/covid-19-data/raw/master/us-counties-2020.csv</data>
      <data key="d2">COVID-19 data for US counties 2020</data>
    </node>
    <node id="county_boundary_url">
      <data key="d0">data</data>
      <data key="d1">https://github.com/gladcolor/spatial_data/raw/master/contiguous_counties.zip</data>
      <data key="d2">Contiguous US county boundaries shapefile</data>
    </node>
    <node id="census_data_url">
      <data key="d0">data</data>
      <data key="d1">https://raw.githubusercontent.com/gladcolor/spatial_data/master/Demography/ACS2020_5year_county.csv</data>
      <data key="d2">Census data with senior population information</data>
    </node>
    <node id="load_covid_data">
      <data key="d0">operation</data>
      <data key="d2">Load COVID-19 data from the URL</data>
    </node>
    <node id="load_county_boundary">
      <data key="d0">operation</data>
      <data key="d2">Load contiguous US county boundaries shapefile</data>
    </node>
    <node id="load_census_data">
      <data key="d0">operation</data>
      <data key="d2">Load census demographic data</data>
    </node>
    <node id="filter_dec_31_data">
      <data key="d0">operation</data>
      <data key="d2">Filter COVID-19 data for 2020-12-31</data>
    </node>
    <node id="calculate_death_rate">
      <data key="d0">operation</data>
      <data key="d2">Calculate death rate per county</data>
    </node>
    <node id="compute_senior_rate">
      <data key="d0">operation</data>
      <data key="d2">Compute senior resident rate from census data</data>
    </node>
    <node id="join_data">
      <data key="d0">operation</data>
      <data key="d2">Join COVID-19 data and census data with county boundaries</data>
    </node>
    <node id="draw_choropleth_map">
      <data key="d0">operation</data>
      <data key="d2">Draw choropleth map for death rate using 'Conus Albers' projection</data>
    </node>
    <node id="draw_scatter_plot">
      <data key="d0">operation</data>
      <data key="d2">Draw scatter plot with regression line for death rate vs senior rate</data>
    </node>
    <node id="covid_data">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Loaded COVID-19 data as DataFrame</data>
    </node>
    <node id="county_boundary">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Loaded county boundary as GeoDataFrame</data>
    </node>
    <node id="census_data">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Loaded census data with senior population columns</data>
    </node>
    <node id="covid_dec_31_data">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Filtered COVID-19 data for 2020-12-31</data>
    </node>
    <node id="death_rate">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Death rate calculated for each county</data>
    </node>
    <node id="senior_rate">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Senior rate calculated from census data</data>
    </node>
    <node id="merged_data">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Joined data: death rate, senior rate and county boundary</data>
    </node>
    <node id="choropleth_map">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Choropleth map for death rate</data>
    </node>
    <node id="scatter_plot">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Scatter plot with regression line for death rate vs senior rate</data>
    </node>
    <edge source="covid_data_url" target="load_covid_data" />
    <edge source="county_boundary_url" target="load_county_boundary" />
    <edge source="census_data_url" target="load_census_data" />
    <edge source="load_covid_data" target="covid_data" />
    <edge source="load_county_boundary" target="county_boundary" />
    <edge source="load_census_data" target="census_data" />
    <edge source="filter_dec_31_data" target="covid_dec_31_data" />
    <edge source="calculate_death_rate" target="death_rate" />
    <edge source="compute_senior_rate" target="senior_rate" />
    <edge source="join_data" target="merged_data" />
    <edge source="draw_choropleth_map" target="choropleth_map" />
    <edge source="draw_scatter_plot" target="scatter_plot" />
    <edge source="covid_data" target="filter_dec_31_data" />
    <edge source="county_boundary" target="join_data" />
    <edge source="census_data" target="compute_senior_rate" />
    <edge source="covid_dec_31_data" target="calculate_death_rate" />
    <edge source="death_rate" target="join_data" />
    <edge source="senior_rate" target="join_data" />
    <edge source="merged_data" target="draw_choropleth_map" />
    <edge source="merged_data" target="draw_scatter_plot" />
  </graph>
</graphml>
