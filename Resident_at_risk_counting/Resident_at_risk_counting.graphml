<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="node" attr.name="description" attr.type="string" />
  <key id="d1" for="node" attr.name="data_path" attr.type="string" />
  <key id="d0" for="node" attr.name="node_type" attr.type="string" />
  <graph edgedefault="directed">
    <node id="haz_waste_shp_url">
      <data key="d0">data</data>
      <data key="d1">https://github.com/gladcolor/LLM-Geo/raw/master/overlay_analysis/HW_Sites_EPSG4326.zip</data>
      <data key="d2">Hazardous waste facility shapefile URL</data>
    </node>
    <node id="load_haz_waste_shp">
      <data key="d0">operation</data>
      <data key="d2">Load hazardous waste facility shapefile</data>
    </node>
    <node id="haz_waste_gdf">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Hazardous waste facility GeoDataFrame</data>
    </node>
    <node id="tract_shp_url">
      <data key="d0">data</data>
      <data key="d1">https://github.com/gladcolor/LLM-Geo/raw/master/overlay_analysis/tract_37_EPSG4326.zip</data>
      <data key="d2">North Carolina tract boundary shapefile URL</data>
    </node>
    <node id="load_tract_shp">
      <data key="d0">operation</data>
      <data key="d2">Load NC tract boundary shapefile</data>
    </node>
    <node id="tract_gdf">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">NC tract boundary GeoDataFrame</data>
    </node>
    <node id="population_csv_url">
      <data key="d0">data</data>
      <data key="d1">https://github.com/gladcolor/LLM-Geo/raw/master/overlay_analysis/NC_tract_population.csv</data>
      <data key="d2">North Carolina tract population CSV URL</data>
    </node>
    <node id="load_population_csv">
      <data key="d0">operation</data>
      <data key="d2">Load NC tract population CSV</data>
    </node>
    <node id="population_df">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">NC tract population DataFrame</data>
    </node>
    <node id="join_population_tracts">
      <data key="d0">operation</data>
      <data key="d2">Join population data to tract boundaries via GEOID</data>
    </node>
    <node id="tracts_with_population_gdf">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Tracts with joined population data</data>
    </node>
    <node id="spatial_join_haz_waste">
      <data key="d0">operation</data>
      <data key="d2">Spatial join to find tracts containing hazardous waste facilities</data>
    </node>
    <node id="hazardous_tracts_gdf">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Tracts containing hazardous waste facilities</data>
    </node>
    <node id="calculate_population">
      <data key="d0">operation</data>
      <data key="d2">Calculate population in hazardous waste tracts</data>
    </node>
    <node id="hazardous_population">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Total population in hazardous waste tracts</data>
    </node>
    <node id="generate_choropleth_map">
      <data key="d0">operation</data>
      <data key="d2">Generate choropleth map with highlighted hazardous waste tracts</data>
    </node>
    <node id="population_choropleth_map">
      <data key="d0">data</data>
      <data key="d1" />
      <data key="d2">Choropleth map with hazardous waste tracts highlighted</data>
    </node>
    <edge source="haz_waste_shp_url" target="load_haz_waste_shp" />
    <edge source="load_haz_waste_shp" target="haz_waste_gdf" />
    <edge source="haz_waste_gdf" target="spatial_join_haz_waste" />
    <edge source="tract_shp_url" target="load_tract_shp" />
    <edge source="load_tract_shp" target="tract_gdf" />
    <edge source="tract_gdf" target="join_population_tracts" />
    <edge source="population_csv_url" target="load_population_csv" />
    <edge source="load_population_csv" target="population_df" />
    <edge source="population_df" target="join_population_tracts" />
    <edge source="join_population_tracts" target="tracts_with_population_gdf" />
    <edge source="tracts_with_population_gdf" target="spatial_join_haz_waste" />
    <edge source="tracts_with_population_gdf" target="generate_choropleth_map" />
    <edge source="spatial_join_haz_waste" target="hazardous_tracts_gdf" />
    <edge source="hazardous_tracts_gdf" target="calculate_population" />
    <edge source="hazardous_tracts_gdf" target="generate_choropleth_map" />
    <edge source="calculate_population" target="hazardous_population" />
    <edge source="generate_choropleth_map" target="population_choropleth_map" />
  </graph>
</graphml>
